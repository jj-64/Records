x=rnorm(50)
X=rnorm(50)
x=rnorm(50)
X=rec_values(x)
t=rec_times(x)
length(X)
# # Centralize data
# t <- t - mean(t)
# X <- X - mean(X)
dat <- data.frame(
X = X,
t = t
)
fit <- robustbase::lmrob(
X ~ t,
data = dat,
method = "MM"
)
# Extract coefficient and standard error
sm <- summary(fit)
theta_hat <- coef(fit)[["t"]]
se_theta <- sm$coefficients["t", "Std. Error"]
t_stat <- theta_hat / se_theta
p_value <- 2 * pt(
-abs(t_stat),
df = fit$df.residual
)
