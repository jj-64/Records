b <- sqrt(seq(1, 2,1))
m_L_c <- simulate_model(
param_values = b,
T = T,
n_sim = n_sim,
generator = rnorm, #VGAM::rgumbel,
param_name = "sd",   # param goes into scale=
n_arg = "n",           # rgumbel expects n=
test_fun =  test_ldm_trend,
series_args = list(mean=0),
test_args = list(obs_type = "records")
)
m_L_c <- simulate_model(
param_values = b,
T = T,
n_sim = n_sim,
generator = rnorm, #VGAM::rgumbel,
param_name = "sd",   # param goes into scale=
n_arg = "n",           # rgumbel expects n=
test_fun =  test_ldm_trend,
series_args = list(mean=0),
test_args = list(obs_type = "records")
)
x=rnorm(50)
X=rnorm(50)
x=rnorm(50)
X=rec_values(x)
t=rec_times(x)
length(X)
# # Centralize data
# t <- t - mean(t)
# X <- X - mean(X)
dat <- data.frame(
X = X,
t = t
)
fit <- robustbase::lmrob(
X ~ t,
data = dat,
method = "MM"
)
# Extract coefficient and standard error
sm <- summary(fit)
theta_hat <- coef(fit)[["t"]]
se_theta <- sm$coefficients["t", "Std. Error"]
t_stat <- theta_hat / se_theta
p_value <- 2 * pt(
-abs(t_stat),
df = fit$df.residual
)
param_values = b;
T = T;
n_sim = n_sim;
generator = rnorm; #VGAM::rgumbel,
param_name = "sd";   # param goes into scale=
n_arg = "n";     # rgumbel expects n=
test_fun =  test_ldm_trend;
series_args = list(mean=0);
test_args = list(obs_type = "records")
results <- as.data.frame(matrix(0, nrow=length(param_values), ncol=length(T)+2))
results[,1] <- param_values
colnames(results) <- c(param_name, paste0("T_", T), "average")
for (k in seq_along(T)) {
for (j in seq_along(param_values)) {
dec <- rep(NA, n_sim)
for (i in 1:n_sim) {
# Build generator args
args <- series_args
args[[param_name]] <- param_values[j]
args[[n_arg]] <- T[k]   # could be "T" or "n"
x <- do.call(generator, args)
# Apply test function
test_call <- c(list(X=rec_values(x), record_times = rec_times(x) ),test_args)
dec[i] <- do.call(test_fun, test_call)$decision
}
valid <- na.omit(dec)
results[j, k+1] <- mean(valid=="no") * 100
}
}
i
test_call
do.call(test_fun, test_call)
