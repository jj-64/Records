## Load from KOBO API -----
load_dot_env(file.path(project_dir,"/01_Tool/.env"))
TOKEN <- Sys.getenv("KOBO_TOKEN")
stopifnot(nzchar(TOKEN))
BASE        <- "https://kobo.unhcr.org"
survey_name <- "South Lebanon Refugee Presence & Vulnerability Validation"
survey_date <- "20261121"
date_from   <- "2026-01-01"
date_to     <- format(Sys.Date(), "%Y-%m-%d")
headers <- add_headers(Authorization = paste("Token", TOKEN))
# Find the asset UID
r <- GET(paste0(BASE, "/api/v2/assets/"), headers,
query = list(format = "json", limit = 1000))
stop_for_status(r)
assets <- fromJSON(content(r, as = "text", encoding = "UTF-8"), flatten = TRUE)
UID <- assets$results$uid[assets$results$name == survey_name]
stopifnot(length(UID) == 1)
# Create the LABEL export
payload <- list(
type                     = "csv",    # or "xls"
lang                     = "_xml",   # XML values and headers "_xml
hierarchy_in_labels      = TRUE,     # include groups in headers
group_sep                = "/",
fields_from_all_versions = TRUE,
multiple_select          = "both"
)
download_export <- function(lang, suffix) {
payload <- list(
type                     = "csv",
lang                     = lang,
hierarchy_in_labels      = TRUE,
group_sep                = "/",
fields_from_all_versions = TRUE,
multiple_select          = "both"
)
# Create export
r <- POST(
paste0(BASE, "/api/v2/assets/", UID, "/exports/"),
headers,
body = payload,
encode = "json"
)
stop_for_status(r)
export_url <- content(r, as = "parsed")$url
# Poll until ready
repeat {
info <- content(GET(export_url, headers), as = "parsed")
if (info$status == "complete") break
if (info$status == "error") stop(toJSON(info, auto_unbox = TRUE))
Sys.sleep(2)
}
# Download
out_file <- file.path(
dirname(project_dir),
"05_submission",
paste0("submission_", suffix, "_", survey_date, ".csv")
)
GET(
info$result,
headers,
write_disk(out_file, overwrite = TRUE)
) |> stop_for_status()
fread(out_file)
}
